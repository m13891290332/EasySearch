# EasySearch 环境变量模板（M1 安全基座）
# 复制本文件为 .env 并填入真实密钥；.env 已加入 .gitignore，不会提交。
#
# 无 Key 时全链路自动降级（离线 fallback 向量 + 关键词 rerank），仍可演示。

# DashScope（qwen3.7-text-embedding / qwen3-vl-rerank）
# 获取：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=

# DeepSeek（deepseek-v4-flash，生成排序理由）
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 知识库 JSON 路径（缺省用项目根 services_dict_50.json）
# EASYSEARCH_KB=

# ---------- M12 错误处理与降级 ----------
# API Key 鉴权（留空则鉴权关闭，所有 /api/* 路由免 Key 访问；适合离线/内网）
# 生产环境强烈建议设置一个随机长串。
# EASYSEARCH_API_KEY=

# 慢速限流（per-IP 令牌桶，每分钟请求数上限；0=禁用限流）
# 默认 60，测试环境 conftest.py 已设为 0 避免套件累计触发 429
# EASYSEARCH_RATE_LIMIT=60

# 上传体积上限（字节，默认 10MB；超过返回 413）
# EASYSEARCH_MAX_BODY_BYTES=10485760

# 告警 webhook（可选，命中告警规则时 POST JSON；留空则仅落 ERROR 日志）
# EASYSEARCH_ALERT_WEBHOOK=

# ---------- 结果缓存（Redis 可选降级内存） ----------
# Redis 连接 URL（配则启用 Redis 缓存，记录最近 5 分钟的 query+结果+推荐理由，
# query 命中即复用；未配或连接失败自动降级进程内存 LRU 缓存 60s）
# 例：redis://localhost:6379/0 或 redis://:password@host:6379/1
# REDIS_URL=
# EASYSEARCH_REDIS_URL=  # 别名，与 REDIS_URL 等效

# 缓存 TTL（秒，仅 Redis 模式生效，默认 300=5min；内存模式固定 60s 保旧行为）
# EASYSEARCH_CACHE_TTL=300
